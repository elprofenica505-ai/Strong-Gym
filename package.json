{
  "name": "strong-gym",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web del gimnasio Strong Gym: landing bilingüe (ES/EN) con reserva de clases, Next.js + Supabase.",
  "scripts": {
    "build": "next build",
    "build:sql": "node scripts/build-sql.mjs",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "test:sql": "node scripts/test-sql.mjs && node scripts/test-crm-sql.mjs && node scripts/test-crm-compat-sql.mjs",
    "typecheck": "tsc --noEmit",
    "test:metadata": "node scripts/test-metadata.mjs",
    "test:finance:rsc": "node scripts/test-finance-rsc.mjs",
    "test:auth": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
