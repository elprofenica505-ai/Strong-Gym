# ============================================================
#  Strong Gym — variables de entorno
# ============================================================
#  Copiá este archivo como ".env.local" y completá los valores.
#
#  SIN estas variables el sitio funciona igual, en MODO DEMO:
#  muestra todo el contenido con datos de ejemplo y las reservas
#  se guardan en tu navegador. Cuando las completes, el sitio
#  pasa automáticamente a usar Supabase (base de datos + login).
#
#  Las encontrás en: Supabase -> tu proyecto -> Project Settings -> API
# ============================================================

# URL del proyecto, ejemplo: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública ("anon" / "publishable"). Es segura para el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
#  OPCIONAL — URL pública para metadatos y enlaces
# ------------------------------------------------------------

# Sitio público del gimnasio (se usa para metadatos y links canónicos).
# Para desarrollo local podés usar http://localhost:3000 sólo en .env.local.
NEXT_PUBLIC_SITE_URL=https://strong-gym-gamma.vercel.app
